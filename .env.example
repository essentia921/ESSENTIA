# ==========================================================
# .env.example — copia in .env e riempi i valori.
# Sul cloud NON si usa questo file: le variabili si impostano
# in Railway (backend + worker) e in Vercel (frontend, quelle VITE_).
# ==========================================================

# --- App / sicurezza ---
SECRET_KEY=                      # chiave per firmare i token JWT (stringa lunga casuale)
DEBUG=false
ADMIN_EMAIL=erba.francesco.mp@gmail.com
PUBLIC_BASE_URL=                 # URL pubblico del BACKEND (Railway), usato nei link email. Es: https://api.tuodominio.com
FRONTEND_URL=                    # URL pubblico del SITO (Vercel). Es: https://tuodominio.com

# --- Database: Supabase Postgres ---
# Dalla dashboard Supabase -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=
SUPABASE_DATABASE_URL=           # opzionale: se presente ha priorita' su DATABASE_URL

# --- Supabase Storage (immagini del blog) ---
SUPABASE_URL=                    # es: https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service role key (Project Settings -> API)
SUPABASE_STORAGE_BUCKET=media    # crea un bucket pubblico con questo nome

# --- Amazon Ads API ---
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REDIRECT_URI=         # deve puntare al nuovo dominio

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=             # aggiorna gli URI autorizzati sul nuovo dominio

# --- Stripe (pagamenti) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=           # il webhook deve puntare al backend Railway
STRIPE_PRICE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- OpenAI (extractor) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini          # modello da usare (cambiabile senza toccare il codice)
# OPENAI_BASE_URL=               # opzionale, lascia vuoto per l'endpoint OpenAI standard

# --- Dati prodotto (extractor / book economics) ---
OXYLABS_USER=
OXYLABS_PASS=
CANOPY_API_KEY=

# ==========================================================
# FRONTEND (Vercel) — variabili che iniziano con VITE_
# ==========================================================
VITE_API_URL=                    # URL del backend + /api. Es: https://api.tuodominio.com/api
VITE_GA4_ID=                     # opzionale: ID Google Analytics 4 (G-XXXXXXXXXX)
